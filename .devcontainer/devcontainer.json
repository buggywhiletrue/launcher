{
    "name": "Mushroom Launcher Web Preview",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
    "hostRequirements": {
        "cpus": 2,
        "memory": "4gb",
        "storage": "16gb"
    },
    "forwardPorts": [5173],
    "portsAttributes": {
        "5173": {
            "label": "Launcher Web Preview",
            "onAutoForward": "openPreview",
            "protocol": "http"
        }
    },
    "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile",
    "postStartCommand": "nohup pnpm preview:web > /tmp/launcher-preview.log 2>&1 &"
}
